#!/usr/bin/env bash
# wallnote: whose-turn-is-it messaging for people and agents, on GitHub Issues.
# Needs only `gh` (logged in). Works with bash 3.2+ (macOS). See .wallnote/PROTOCOL.md.
set -euo pipefail

VERSION=0.4.2
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

die() { echo "wallnote: $*" >&2; exit 1; }

# ---------- context ----------

repo() {
  if [[ -n "${GH_REPO:-}" ]]; then echo "$GH_REPO"; return; fi
  local url; url=$(git remote get-url origin 2>/dev/null) || die "no git remote 'origin'"
  url=${url%.git}; url=${url#*github.com[:/]}
  echo "$url"
}

_ME=""
me() {
  if [[ -n "${WALLNOTE_ME:-}" ]]; then echo "$WALLNOTE_ME"; return; fi
  if [[ -z "$_ME" ]]; then
    local pf; pf="$(git rev-parse --git-common-dir 2>/dev/null)/wallnote.conf"
    _ME=$(conf_get "$pf" login "")
    if [[ -z "$_ME" ]]; then _ME=$(gh api user --jq .login); [[ -f "$pf" ]] && conf_set "$pf" login "$_ME"; fi
  fi
  echo "$_ME"
}

gitdir()    { git rev-parse --git-dir; }          # per worktree
commondir() { git rev-parse --git-common-dir; }   # per clone

# ---------- settings ----------
# Team (committed):    .wallnote/config        key = value
# Personal (local):    <git-common-dir>/wallnote.conf
# Role (per worktree): <git-dir>/wallnote-role

conf_get() { # file key default
  local v=""
  [[ -f "$1" ]] && v=$(grep -E "^[[:space:]]*$2[[:space:]]*=" "$1" | tail -1 | sed -E 's/^[^=]*=[[:space:]]*//; s/[[:space:]]*(#.*)?$//') || true
  [[ -n "$v" ]] && echo "$v" || echo "$3"
}
conf_set() { # file key value
  local f=$1 tmp; touch "$f"; tmp="$f.tmp.$$"
  grep -vE "^[[:space:]]*$2[[:space:]]*=" "$f" > "$tmp" || true
  echo "$2 = $3" >> "$tmp"; mv "$tmp" "$f"
}

rules_text() { [[ -f "$HERE/rules.md" ]] && sed '/<!--/,/-->/d' "$HERE/rules.md" | grep -v '^[[:space:]]*$' || true; }
team()     { conf_get "$HERE/config" "$1" "$2"; }
personal_file() { echo "$(commondir)/wallnote.conf"; }
personal() { conf_get "$(personal_file)" "$1" "$2"; }
my_role()  { cat "$(gitdir)/wallnote-role" 2>/dev/null || true; }

level_num() { case "$1" in notify) echo 1;; ack) echo 2;; act) echo 3;; *) echo 1;; esac; }
autonomy() { # effective: min(personal, team max)
  local p t; p=$(personal autonomy ack); t=$(team max_autonomy act)
  if [[ $(level_num "$p") -le $(level_num "$t") ]]; then echo "$p"; else echo "$t"; fi
}

# ---------- helpers ----------

read_body() {
  if [[ "${1:-}" == "--body-file" ]]; then
    [[ -n "${2:-}" ]] || die "--body-file needs a path (or - for stdin)"
    if [[ "$2" == "-" ]]; then cat; else [[ -f "$2" ]] || die "no such file: $2"; cat "$2"; fi
    return
  fi
  if [[ $# -gt 0 && "$1" != "-" ]]; then printf '%s' "$*"
  elif [[ ! -t 0 ]]; then
    # Piped or heredoc text. Agent shells often leave stdin open with nothing coming, so give up
    # after a moment instead of waiting forever (an optional note, like ack's, is then empty).
    local first=""
    if IFS= read -r -t 2 first || [[ -n "$first" ]]; then printf '%s\n' "$first"; cat; fi
  else echo ""; fi
}

# "@alice", "@alice/frontend", "@me", "@me/backend" -> sets TO_USER and TO_ROLE
# default_roles = alice:core bob:editorial  ->  "@alice" means "@alice/core"
default_role() { local x; for x in $(team default_roles ""); do [[ "${x%%:*}" == "$1" ]] && { echo "${x#*:}"; return; }; done; }

parse_to() { # sets TO_USER, TO_ROLE, TO_KEEP (1 = "@me" with no role: keep the ball as it is)
  local t=${1#@}; TO_USER=${t%%/*}; TO_ROLE=""; TO_KEEP=0
  [[ "$t" == */* ]] && TO_ROLE=${t#*/}
  [[ "$TO_USER" == "me" ]] && { TO_USER=$(me); [[ -z "$TO_ROLE" ]] && TO_KEEP=1; }
  [[ -z "$TO_ROLE" && $TO_KEEP -eq 0 ]] && TO_ROLE=$(default_role "$TO_USER")
  if [[ -n "$TO_ROLE" ]]; then
    local roles; roles=$(team roles "")
    if [[ -n "$roles" && " $roles " != *" $TO_ROLE "* ]]; then
      die "unknown role '$TO_ROLE' (team roles: $roles; see .wallnote/config)"
    fi
  fi
  return 0
}

json_escape() {
  local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\t'/\\t}; s=${s//$'\r'/}; s=${s//$'\n'/\\n}
  printf '%s' "$s"
}

signature() {
  local r; r=$(my_role)
  printf '<sub>via wallnote · @%s%s</sub>' "$(me)" "${r:+/$r}"
}

labels_of() { gh api "repos/$(repo)/issues/$1" --jq '[.labels[].name] | join(" ")'; }

# Set the ball: single assignee, one role:* label (or none), clear ack labels.
set_ball() { # issue user role
  local r n=$1 u=$2 role=${3:-} l; r=$(repo)
  gh api -X PATCH "repos/$r/issues/$n" -f "assignees[]=$u" >/dev/null || die "couldn't assign @$u (do they have access to $r?)"
  for l in $(labels_of "$n"); do
    case "$l" in role:*|acked*) [[ "$l" == "role:$role" ]] || gh api -X DELETE "repos/$r/issues/$n/labels/$l" >/dev/null 2>&1 || true;; esac
  done
  [[ -n "$role" ]] && gh api -X POST "repos/$r/issues/$n/labels" -f "labels[]=role:$role" >/dev/null
  return 0
}

# Is this GitHub user allowed to message us?
_PERMS="|"
allowed() {
  [[ "$(team allowed_authors collaborators)" == "anyone" ]] && return 0
  local u=$1 p
  case "$u" in *"[bot]") return 1;; esac
  case "$_PERMS" in *"|$u:"*) p=${_PERMS#*|$u:}; p=${p%%|*};;
    *) p=$(gh api "repos/$(repo)/collaborators/$u/permission" --jq .permission 2>/dev/null || echo none)
       _PERMS="$_PERMS$u:$p|";; esac
  [[ "$p" == admin || "$p" == maintain || "$p" == write || "$p" == triage ]]
}

# jq filter: keep issues for me (+ my role, if I have one)
ROLE_FILTER='| map(select(([.labels[].name | select(startswith("role:")) | ltrimstr("role:")]) as $rl
  | ($rl|length)==0 or $role=="" or ($rl|index($role))))'

# ---------- commands ----------

usage() {
  cat <<'EOF'
wallnote: threads with a ball. Every open thread is waiting on exactly one person.

Reading
  wallnote ready                 threads waiting on you (and your role), not blocked
  wallnote check                 anything NEW for you since the last check (quiet if not)
  wallnote show N                read a thread (only allowed authors are shown)
  wallnote waiting               every open thread, grouped by who holds the ball
  wallnote inbox [--peek]        everything that changed since you last looked

Writing (every post says whose turn is next; any body can come from --body-file F, - = stdin)
  wallnote open "title" --to @who[/role] [body|-|--body-file F] [--force]
                                 (WALLNOTE_NO_DEDUPE=1 skips the duplicate check for a whole batch)
  wallnote reply N --to @who[/role] [body|-|--body-file F]   hand the ball on (@me keeps it)
  wallnote ack N [note]                            "got it, on it"; you keep the ball
  wallnote progress N "update"                     status update; you keep the ball
  wallnote block N --on M                          N can't move until M is closed
  wallnote close N "what was decided and why"

Settings
  wallnote settings              show team + personal settings
  wallnote setup --autonomy notify|ack|act --check prompt,stop|prompt|stop|session [--every 5m] [--role R]
  wallnote role [R|--clear]      this agent's role (per working copy)
  wallnote update                update wallnote in this repo (keeps team settings)
EOF
}

cmd_ready() {
  local out; out=$(ready_list)
  if [[ -n "$out" ]]; then echo "$out"; else echo "Nothing waiting on @$(me)$( [[ -n "$(my_role)" ]] && echo "/$(my_role)")."; fi
  setup_note
}

setup_note() {
  is_setup || echo "(Note: wallnote turns itself on with default settings at your next agent session, or run: .wallnote/wallnote check)" >&2
  return 0
}

ready_list() {
  local r u role; r=$(repo); u=$(me); role=$(my_role)
  gh api "repos/$r/issues?state=open&assignee=$u&per_page=100" --jq "
    (\"$role\") as \$role | map(select(.pull_request|not)) $ROLE_FILTER
    | map(select((.issue_dependencies_summary.blocked_by // 0) == 0))
    | sort_by(.updated_at)
    | .[] | \"#\(.number)\t\(.title)\"
      + ([.labels[].name | select(startswith(\"role:\"))] | if length>0 then \"\t[\(join(\",\"))]\" else \"\" end)
      + ([.labels[].name | select(startswith(\"acked\"))] | if length>0 then \"\t[\(.[0])]\" else \"\" end)
      + \"\t(\(((now - (.updated_at|fromdate))/3600|floor))h)\""
}

cmd_waiting() {
  local r out; r=$(repo)
  out=$(waiting_list "$r")
  if [[ -n "$out" ]]; then echo "$out"; else echo "No open threads."; fi
  setup_note
}

waiting_list() {
  local r=$1
  gh api "repos/$r/issues?state=open&per_page=100" --jq '
    def line(ind): "\(ind)#\(.number)\t\(.title)\t\(((now - (.updated_at|fromdate))/3600|floor))h"
      + (if (.issue_dependencies_summary.blocked_by // 0) > 0 then "\t[blocked]" else "" end)
      + ([.labels[].name | select(startswith("acked"))] | if length>0 then "\t[acked]" else "" end);
    map(select(.pull_request|not))
    | map(. + {person: (.assignees[0].login // "NOBODY (fix this)"),
               role: ([.labels[].name | select(startswith("role:")) | ltrimstr("role:")] | .[0] // "")})
    | group_by(.person) | .[]
    | "\n== waiting on @\(.[0].person) (\(length)) ==",
      (group_by(.role) | .[]
        | if .[0].role == "" then (sort_by(.updated_at) | .[] | line("  "))
          else "  -- @\(.[0].person)/\(.[0].role) (\(length))", (sort_by(.updated_at) | .[] | line("    ")) end)'
}

cmd_inbox() {
  local peek=0; [[ "${1:-}" == "--peek" ]] && peek=1
  local r u cf since now_ts; r=$(repo); u=$(me); cf="$(gitdir)/wallnote-last-seen"
  since=$(cat "$cf" 2>/dev/null || echo "1970-01-01T00:00:00Z")
  now_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  gh api -X GET search/issues -f q="repo:$r is:issue involves:$u updated:>$since" -f sort=updated -f per_page=50 --jq '
    .items[] | "#\(.number)\t[\(.state)]\t\(.title)\tball: \(.assignees[0].login // "-")\tupdated \(.updated_at)"'
  [[ $peek -eq 1 ]] || echo "$now_ts" > "$cf"
}

cmd_show() {
  local n=${1#\#}; [[ -n "$n" ]] || die "usage: wallnote show N"
  local r line author hidden=0; r=$(repo)
  gh api "repos/$r/issues/$n" --jq '"#\(.number) \(.title)  [\(.state)]  ball: @\(.assignees[0].login // "-")\(.labels | map(.name) | map(select(startswith("role:"))) | if length>0 then " " + join(",") else "" end)\n"'
  # Body + comments as records separated by \x1e so each author can be checked.
  local rec
  while IFS= read -r -d $'\x1e' rec; do
    rec=${rec#$'\n'}; author=${rec%%$'\t'*}
    if allowed "$author"; then printf '%s\n\n' "${rec#*$'\t'}"; else hidden=$((hidden+1)); fi
  done < <(
    gh api "repos/$r/issues/$n" --jq '[.user.login, "--- @\(.user.login), \(.created_at) (opened)\n\(.body // "")"] | join("\t") + "\u001e"'
    gh api --paginate "repos/$r/issues/$n/comments?per_page=100" --jq '.[] | [.user.login, "--- @\(.user.login), \(.created_at)\n\(.body)"] | join("\t") + "\u001e"'
  )
  [[ $hidden -gt 0 ]] && echo "($hidden post(s) hidden: not from repo collaborators)"
  return 0
}

cmd_open() {
  local title="" to="" force=0 args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --to) to=$2; shift 2;;
      --force|--no-dedupe) force=1; shift;;
      --body-file) args+=("$1" "${2:-}"); shift 2;;
      *) if [[ -z "$title" ]]; then title=$1; else args+=("$1"); fi; shift;;
    esac
  done
  [[ "${WALLNOTE_NO_DEDUPE:-}" == 1 ]] && force=1
  [[ -n "$title" ]] || die "usage: wallnote open \"title\" --to @who[/role] [body]"
  [[ -n "$to" ]] || die "--to is required (whose turn is it?)"
  parse_to "$to"
  local r; r=$(repo)
  if [[ $force -eq 0 ]]; then
    local qt=${title//\\/\\\\}; qt=${qt//\"/\\\"}
    local dupes
    dupes=$(gh api "repos/$r/issues?state=open&sort=updated&per_page=100" --jq '
      def words: ascii_downcase | [scan("[a-z0-9]{3,}")] | map(select(IN("the","and","for","with","this","that","does","from","test")|not)) | unique;
      ("'"$qt"'"|words) as $w
      | map(select(.pull_request|not))
      | map(. as $i | ($i.title|words) as $v
          | ([$w[] | select(IN($v[]))] | length) as $hit
          | select(($w|length) > 0 and $hit * 2 >= ([($w|length),($v|length)]|min) and $hit > 0))
      | .[:5][] | "  #\(.number)\t\(.title)\tball: \(.assignees[0].login // "-")"' 2>/dev/null || true)
    if [[ -n "$dupes" ]]; then
      echo "Possible duplicates. Reply to one of these instead, or re-run with --force:" >&2
      echo "$dupes" >&2
      exit 2
    fi
  fi
  local body url n; body=$(read_body "${args[@]+"${args[@]}"}")
  body=$(printf '%s\n\n→ @%s%s\n\n%s' "$body" "$TO_USER" "${TO_ROLE:+/$TO_ROLE}" "$(signature)")
  url=$(gh issue create -R "$r" --title "$title" --body "$body" --assignee "$TO_USER")
  n=${url##*/}
  [[ -n "$TO_ROLE" ]] && set_ball "$n" "$TO_USER" "$TO_ROLE"
  echo "$url"
}

post() { # issue body
  gh issue comment "$1" -R "$(repo)" --body "$2" >/dev/null
}

cmd_reply() {
  local n="" to="" args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --to) to=$2; shift 2;;
      --body-file) args+=("$1" "${2:-}"); shift 2;;
      *) if [[ -z "$n" ]]; then n=${1#\#}; else args+=("$1"); fi; shift;;
    esac
  done
  [[ -n "$n" ]] || die "usage: wallnote reply N --to @who[/role] [body]"
  [[ -n "$to" ]] || die "--to is required (whose turn is next? --to @me keeps it)"
  parse_to "$to"
  local body; body=$(read_body "${args[@]+"${args[@]}"}")
  [[ -n "$body" ]] || die "empty body"
  if [[ $TO_KEEP -eq 1 ]]; then
    post "$n" "$(printf '%s\n\n→ @me\n\n%s' "$body" "$(signature)")"
    echo "#$n (ball stays with you)"; return 0
  fi
  post "$n" "$(printf '%s\n\n→ @%s%s\n\n%s' "$body" "$TO_USER" "${TO_ROLE:+/$TO_ROLE}" "$(signature)")"
  set_ball "$n" "$TO_USER" "$TO_ROLE"
  echo "#$n → @$TO_USER${TO_ROLE:+/$TO_ROLE}"
}

cmd_ack() {
  local n=${1#\#}; shift || true
  [[ -n "$n" ]] || die "usage: wallnote ack N [note]"
  local note; note=$(read_body "$@"); local role; role=$(my_role)
  post "$n" "$(printf '**ack**: got it, on it.%s\n\n→ @me\n\n%s' "${note:+ $note}" "$(signature)")"
  gh api -X POST "repos/$(repo)/issues/$n/labels" -f "labels[]=acked${role:+:$role}" >/dev/null
  echo "#$n acked"
}

cmd_progress() {
  local n=${1#\#}; shift || true
  local body; body=$(read_body "$@")
  [[ -n "$n" && -n "$body" ]] || die "usage: wallnote progress N \"update\""
  post "$n" "$(printf '**progress**: %s\n\n→ @me\n\n%s' "$body" "$(signature)")"
  echo "#$n updated"
}

cmd_block() {
  local n=${1#\#}; [[ "${2:-}" == "--on" && -n "${3:-}" ]] || die "usage: wallnote block N --on M"
  local m=${3#\#} r id; r=$(repo)
  id=$(gh api "repos/$r/issues/$m" --jq .id)
  gh api -X POST "repos/$r/issues/$n/dependencies/blocked_by" -F issue_id="$id" >/dev/null
  echo "#$n is blocked by #$m"
}

cmd_close() {
  local n=${1#\#}; shift || true
  local reason; reason=$(read_body "$@")
  [[ -n "$n" ]] || die "usage: wallnote close N \"what was decided\""
  if [[ -n "$reason" ]]; then gh issue close "$n" -R "$(repo)" -c "Closed: $reason"$'\n\n'"$(signature)"
  else gh issue close "$n" -R "$(repo)"; fi
}

# ---------- settings commands ----------

cmd_settings() {
  local pf; pf=$(personal_file)
  echo "Team (.wallnote/config, shared):"
  echo "  allowed_authors = $(team allowed_authors collaborators)"
  echo "  max_autonomy    = $(team max_autonomy act)"
  echo "  roles           = $(team roles '(any)')"
  echo "  forbid          = $(team forbid '(nothing)')"
  [[ -n "$(rules_text)" ]] && echo "  + free-text rules in .wallnote/rules.md"
  echo "Personal ($pf):"
  if [[ -f "$pf" ]] && grep -q autonomy "$pf"; then
    echo "  autonomy = $(personal autonomy ack)  (effective: $(autonomy))"
    echo "  check    = $(personal check prompt,stop), at most every $(personal check_interval 60)s  (setup --every 5m)"
  else
    echo "  not set up. Run: wallnote setup --autonomy notify|ack|act --check prompt,stop [--role R]"
  fi
  echo "This agent's role: $(my_role | grep . || echo '(none: sees everything addressed to you)')"
}

cmd_setup() {
  if [[ $# -eq 0 ]]; then onboarding; return 0; fi
  local a="" c="" role="" e=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --autonomy) a=$2; shift 2;; --check) c=$2; shift 2;; --role) role=$2; shift 2;;
      --every) e=$2; shift 2;;
      *) die "unknown option $1";;
    esac
  done
  [[ -z "$a" ]] || [[ "$a" == notify || "$a" == ack || "$a" == act ]] || die "--autonomy must be notify, ack or act"
  local pf; pf=$(personal_file)
  [[ -n "$a" ]] && conf_set "$pf" autonomy "$a"
  [[ -n "$c" ]] && conf_set "$pf" check "$c"
  if [[ -n "$e" ]]; then # 30s, 5m, 1h, or plain seconds
    local secs
    case "$e" in *[0-9]s) secs=${e%s};; *[0-9]m) secs=$(( ${e%m} * 60 ));; *[0-9]h) secs=$(( ${e%h} * 3600 ));; *) secs=$e;; esac
    [[ "$secs" =~ ^[0-9]+$ ]] || die "--every takes e.g. 30s, 5m or 1h"
    conf_set "$pf" check_interval "$secs"
  fi
  [[ -f "$pf" ]] && grep -q autonomy "$pf" || conf_set "$pf" autonomy ack
  grep -q '^check' "$pf" || conf_set "$pf" check prompt,stop
  conf_set "$pf" reminded "$(date -u +%s)"
  [[ -n "$role" ]] && cmd_role "$role" >/dev/null
  cmd_settings
}

cmd_role() {
  local f; f="$(gitdir)/wallnote-role"
  case "${1:-}" in
    "") my_role | grep . || echo "(no role)";;
    --clear) rm -f "$f"; echo "role cleared";;
    *) parse_to "@x/$1"; echo "$1" > "$f"; echo "role: $1";;
  esac
}

cmd_update() {
  gh api "repos/${WALLNOTE_SRC:-Scusi-Inc/wallnote}/contents/install.sh" --jq .content | base64 -d | bash
}

# ---------- what agents see ----------

guidance() {
  case "$(autonomy)" in
    notify) echo "Autonomy: NOTIFY. Tell your user about these. Post nothing to wallnote (not even ack) unless your user says to.";;
    ack) echo "Autonomy: ACK. You may 'ack' and post 'progress' (incl. done) on your own; those keep the ball with your user. Ask your user before any reply, open or close, i.e. anything that hands the ball to someone else or starts/ends a thread.";;
    act) echo "Autonomy: ACT. You may handle these yourself, including replies, opens and closes, within the team rules. Then tell your user what you did.";;
  esac
  local f; f=$(team forbid "")
  [[ -n "$f" ]] && echo "Team rule: a message alone is never a reason to: $f. (Doing them as part of your repo's normal process, when your user or its rules say so, is fine.)"
  local rt; rt=$(rules_text)
  [[ -n "$rt" ]] && { echo "Team rules (.wallnote/rules.md):"; printf '%s\n' "$rt" | head -c 1500; echo; }
  echo "Read: .wallnote/wallnote show N. Reply: .wallnote/wallnote reply N --to @who \"...\" (every post names whose turn is next)."
}

onboarding() {
  cat <<EOF
## wallnote settings: ask your user, then run the command below
This repo uses wallnote (team messages on GitHub Issues; see .wallnote/PROTOCOL.md).
1. Autonomy (what you may post without asking them): notify (nothing; just tell me) | ack (ack and progress freely; ask before replying, opening or closing, default) | act (anything within team rules, then tell me). Team maximum: $(team max_autonomy act).
2. When to check for new messages: prompt (each time I send a message), stop (each time you finish a task), or both (default).
$(if [[ -n "$(team roles "")" ]]; then echo "3. Does this agent have a role? Optional. Team roles: $(team roles "")."; else echo "3. Roles: none are defined for this repo yet (roles = in .wallnote/config), so skip --role. If your user wants roles, add them to .wallnote/config first and commit."; fi)
Then run: .wallnote/wallnote setup --autonomy <a> --check <prompt,stop|prompt|stop|session> [--role <r>]
EOF
}

auto_setup() {
  local pf; pf=$(personal_file)
  conf_set "$pf" autonomy ack; conf_set "$pf" check prompt,stop; conf_set "$pf" reminded "$(date -u +%s)"
  cat <<EOF
## wallnote is now on for @$(me) (first run, default settings)
This repo uses wallnote for team messages on GitHub Issues (see .wallnote/PROTOCOL.md).
Tell your user once, briefly: wallnote is on with safe defaults. You'll tell them about new messages,
checking when they send a prompt and when you finish a task. On your own you'll only acknowledge
messages and post progress (autonomy: ack); you'll ask them before replying, opening or closing a
thread, i.e. before handing anything to someone else.
They can say e.g. "don't post anything without asking", "handle messages yourself", "check every 10 minutes"
or "give this agent the <role> role", and you'd run:
.wallnote/wallnote setup --autonomy notify|ack|act --check prompt,stop --every 10m  /  .wallnote/wallnote role <r>
$(if [[ -n "$(team roles "")" ]]; then echo "Team roles: $(team roles ""). Autonomy maximum here: $(team max_autonomy act)."; else echo "Autonomy maximum here: $(team max_autonomy act)."; fi)
EOF
}

is_setup() { [[ -f "$(personal_file)" ]] && grep -q autonomy "$(personal_file)"; }

# New since last check: threads waiting on me (and my role) touched by someone else.
new_for_me() { # [min-seconds-since-last-check]
  local r u role cf since now_ts; r=$(repo); u=$(me); role=$(my_role)
  cf="$(gitdir)/wallnote-checked"; now_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  since=$(cat "$cf" 2>/dev/null || echo "")
  if [[ -n "${1:-}" && -n "$since" ]]; then
    local last; last=$(cat "$cf.epoch" 2>/dev/null || echo 0)
    [[ $(( $(date -u +%s) - last )) -lt $1 ]] && return 0   # checked recently: free
  fi
  date -u +%s > "$cf.epoch"
  echo "$now_ts" > "$cf"
  [[ -z "$since" ]] && return 0   # first run: session start covers the backlog
  # Notifications only cover other people's activity, so my own posts never wake me.
  local nums; nums=$(gh api "repos/$r/notifications?all=true&since=$since" --jq '.[] | select(.subject.type=="Issue") | .subject.url | split("/") | last' 2>/dev/null | sort -u) || return 0
  [[ -z "$nums" ]] && return 0
  local n
  local cnt last
  for n in $nums; do
    # Skip threads where the latest post is mine (e.g. the Action re-assigning my own reply).
    cnt=$(gh api "repos/$r/issues/$n" --jq .comments 2>/dev/null || echo 0)
    if [[ "$cnt" -gt 0 ]]; then last=$(gh api "repos/$r/issues/$n/comments?per_page=1&page=$cnt" --jq '.[0].user.login' 2>/dev/null || true)
    else last=$(gh api "repos/$r/issues/$n" --jq .user.login 2>/dev/null || true); fi
    [[ "$last" == "$u" ]] && continue
    allowed "$last" || continue
    gh api "repos/$r/issues/$n" --jq "
      (\"$role\") as \$role | [.] | map(select(.state==\"open\" and (.assignees|map(.login)|index(\"$u\")))) $ROLE_FILTER
      | .[] | \"#\(.number)\t\(.title)\" + (if (.issue_dependencies_summary.blocked_by // 0) > 0 then \"\t[blocked]\" else \"\" end)" 2>/dev/null || true
  done
}

# Once a day at most: is a newer wallnote published? Only reads a public file; sends nothing.
update_line() {
  local f now last latest; f="$(commondir)/wallnote-version-check"; now=$(date -u +%s)
  last=$(head -1 "$f" 2>/dev/null || echo 0)
  if [[ $((now - last)) -ge 86400 ]]; then
    local src; src=$(gh api "repos/${WALLNOTE_SRC:-Scusi-Inc/wallnote}/contents/.wallnote/wallnote" --jq .content 2>/dev/null | base64 -d 2>/dev/null) || src=""
    latest=$(printf '%s\n' "$src" | grep '^VERSION=' | head -1 | cut -d= -f2)
    printf '%s\n%s\n' "$now" "$latest" > "$f"
  else
    return 0   # already checked (and, if needed, mentioned) today
  fi
  [[ -n "$latest" && "$latest" != "$VERSION" ]] || return 0
  # Only suggest if newer (sort -V puts the higher version last).
  [[ "$(printf '%s\n%s\n' "$VERSION" "$latest" | sort -V | tail -1)" == "$latest" ]] || return 0
  echo "(wallnote $latest is available; this repo has $VERSION. Changes: https://github.com/${WALLNOTE_SRC:-Scusi-Inc/wallnote}/blob/main/CHANGELOG.md. Suggest to your user once: run .wallnote/wallnote update, then commit.)"
}

remind_line() {
  local last; last=$(personal reminded 0); local now; now=$(date -u +%s)
  if [[ $((now - last)) -gt 604800 ]]; then
    conf_set "$(personal_file)" reminded "$now"
    echo "(wallnote settings: autonomy=$(autonomy), check=$(personal check prompt,stop)$( [[ -n "$(my_role)" ]] && echo ", role=$(my_role)"). Mention to your user once that they can change these: .wallnote/wallnote settings)"
  fi
}

# Hook entry point. Never fails, never blocks a session.
cmd_hook() {
  local event=${1:-session} input="" checks
  [[ -t 0 ]] || input=$(cat || true)
  git rev-parse --git-dir >/dev/null 2>&1 || exit 0
  if ! is_setup; then
    [[ "$event" == "session" ]] || exit 0
    auto_setup
  fi
  checks=$(personal check prompt,stop)
  case "$event" in
    session)
      local ready; ready=$(ready_list 2>/dev/null) || exit 0
      new_for_me >/dev/null 2>&1 || true   # reset "new" cursor
      local rem; rem=$(remind_line; update_line 2>/dev/null || true)
      [[ -z "$ready" && -z "$rem" ]] && exit 0
      if [[ -n "$ready" ]]; then
        echo "## wallnote: waiting on @$(me)$( [[ -n "$(my_role)" ]] && echo "/$(my_role)")"
        echo "$ready"; guidance
      fi
      [[ -n "$rem" ]] && echo "$rem"
      ;;
    prompt|stop)
      [[ ",$checks," == *",$event,"* ]] || exit 0
      # Stop hook re-entry guard.
      [[ "$event" == "stop" && "$input" == *'"stop_hook_active":true'* ]] && exit 0
      local new min=""
      min=$(personal check_interval 60)   # at most one check per interval (setup --every)
      new=$(new_for_me "$min" 2>/dev/null) || exit 0
      [[ -z "$new" ]] && exit 0
      local msg; msg=$(printf '## wallnote: new for @%s\n%s\n%s' "$(me)" "$new" "$(guidance)")
      if [[ "$event" == "prompt" ]]; then
        echo "$msg"
      else
        # Ask Claude to continue just long enough to surface the message.
        printf '{"decision":"block","reason":"%s"}\n' "$(json_escape "$msg
(Surface this to your user now, per the autonomy above.)")"
      fi
      ;;
  esac
  exit 0
}

# For agents without hooks (Codex, Cursor...): same as the stop check, printed plainly.
cmd_check() {
  is_setup || auto_setup
  update_line 2>/dev/null || true
  local new; new=$(new_for_me)
  [[ -z "$new" ]] && { echo "nothing new"; return 0; }
  echo "New for @$(me):"; echo "$new"; guidance
}

# ---------- GitHub Action ----------
# Keeps the ball valid when people post from the GitHub UI.
cmd_action() {
  local ev=${GITHUB_EVENT_PATH:?} name=${GITHUB_EVENT_NAME:?}
  local r=${GITHUB_REPOSITORY:?}
  local n author text assignees state assoc
  n=$(jq -r .issue.number "$ev")
  assignees=$(jq -r '[.issue.assignees[].login] | join(" ")' "$ev")
  state=$(jq -r .issue.state "$ev")
  [[ "$state" == "open" ]] || exit 0
  if [[ "$name" == "issue_comment" ]]; then
    # Use the latest non-bot comment (not necessarily this event's): runs for rapid comments can be
    # cancelled or land out of order, and each run must leave the ball where the newest post says.
    local latest
    latest=$(gh api --paginate "repos/$r/issues/$n/comments?per_page=100" --jq '.[] | select(.user.login|endswith("[bot]")|not) | {u:.user.login, a:.author_association, b:.body} | @base64' | tail -1)
    if [[ -n "$latest" ]]; then
      author=$(printf '%s' "$latest" | base64 -d | jq -r .u); assoc=$(printf '%s' "$latest" | base64 -d | jq -r .a); text=$(printf '%s' "$latest" | base64 -d | jq -r .b)
    else
      author=$(jq -r .comment.user.login "$ev"); text=$(jq -r .comment.body "$ev"); assoc=$(jq -r .comment.author_association "$ev")
    fi
    assignees=$(gh api "repos/$r/issues/$n" --jq '[.assignees[].login] | join(" ")')
  else
    author=$(jq -r .issue.user.login "$ev"); text=$(jq -r '.issue.body // ""' "$ev"); assoc=$(jq -r .issue.author_association "$ev")
  fi
  [[ "$author" == *"[bot]" ]] && exit 0
  if [[ "$(team allowed_authors collaborators)" != "anyone" ]]; then
    local perm; perm=$(gh api "repos/$r/collaborators/$author/permission" --jq .permission 2>/dev/null || echo "")
    case "$perm" in admin|maintain|write|triage) ;; "") case "$assoc" in OWNER|MEMBER|COLLABORATOR) ;; *) echo "ignoring $author ($assoc)"; exit 0;; esac;;
      *) echo "ignoring $author ($perm)"; exit 0;; esac
  fi

  # Last handoff line wins: "→ @x", "-> @x", "/ball @x", optionally "@x/role". "@me" = the author.
  local to="" role="" h
  h=$(printf '%s\n' "$text" | grep -oE '^[[:space:]]*(→|->|/ball)[[:space:]]*@[A-Za-z0-9-]+(/[A-Za-z0-9_-]+)?' | tail -1 | grep -oE '@[A-Za-z0-9-]+(/[A-Za-z0-9_-]+)?' || true)
  if [[ -n "$h" ]]; then
    h=${h#@}; to=${h%%/*}; [[ "$h" == */* ]] && role=${h#*/}
    # "→ @me" with no role (ack, progress, keep): leave the ball, its role and its ack label alone,
    # as long as the author already holds it.
    if [[ "$to" == "me" ]]; then
      to=$author
      [[ -z "$role" && " $assignees " == *" $author "* ]] && { echo "ball stays with $author"; exit 0; }
    fi
  fi

  if [[ -z "$to" ]]; then
    if [[ "$name" == "issues" ]]; then
      [[ -z "$assignees" ]] && to=$author || exit 0
    elif [[ " $assignees " == *" $author "* ]]; then
      # Reply with no handoff: ball goes back to whoever you're answering
      # (the latest other human in the thread, else the opener).
      local opener; opener=$(jq -r .issue.user.login "$ev")
      to=$(gh api "repos/$r/issues/$n/comments?per_page=100" --jq \
        "[.[] | .user.login | select(. != \"$author\" and (endswith(\"[bot]\")|not))] | last // empty")
      [[ -z "$to" && "$opener" != "$author" ]] && to=$opener
      [[ -z "$to" ]] && exit 0
    else
      [[ -z "$assignees" ]] && to=$author || exit 0
    fi
  fi

  [[ -z "$role" ]] && role=$(default_role "$to")
  if ! gh api -X PATCH "repos/$r/issues/$n" -f "assignees[]=$to" >/dev/null 2>&1; then
    gh issue comment "$n" -R "$r" --body "⚠️ wallnote couldn't hand the ball to @$to (no repo access?). Ball unchanged." >/dev/null
    exit 0
  fi
  local l
  for l in $(gh api "repos/$r/issues/$n" --jq '[.labels[].name] | join(" ")'); do
    case "$l" in role:*|acked*) [[ "$l" == "role:$role" ]] || gh api -X DELETE "repos/$r/issues/$n/labels/$l" >/dev/null 2>&1 || true;; esac
  done
  [[ -n "$role" ]] && gh api -X POST "repos/$r/issues/$n/labels" -f "labels[]=role:$role" >/dev/null || true
}

# Everything runs from main, and the last line exits: bash has read the whole file before any
# command runs, so `wallnote update` replacing this file mid-run can't make bash read garbage.
main() {
  case "${1:-}" in
    ready|inbox|waiting|show|open|reply|ack|progress|block|close|settings|setup|role|hook|check|update)
      c=$1; shift; "cmd_$c" "$@";;
    _action) shift; cmd_action "$@";;
    version|--version) echo "$VERSION";;
    ""|-h|--help|help) usage;;
    *) die "unknown command '$1' (try: wallnote help)";;
  esac
}

main "$@"; exit $?
