# wallnote team settings: committed, shared by everyone on this repo.
# Personal settings (autonomy, when to check) live in each person's clone: run `.wallnote/wallnote settings`.

# Whose posts agents see:
#   auto (default): collaborators on a private repo; on a public repo, only people who can push code
#   collaborators: triage access or more  |  writers: push access or more  |  anyone
#   or a list of logins: alice bob
# Each person can narrow this for their own agents with `wallnote accept alice bob` (kept in
# their personal settings, so only they can change it).
# Note: anyone who can push to main can change this file (and your agent instructions). Protect
# main (and use CODEOWNERS) if that matters to you.
allowed_authors = auto

# The most any agent here may do on its own when a message arrives: notify | ack | act
max_autonomy = act

# Known roles, space-separated (optional). Addressing @alice/<role> with an unlisted role is rejected.
roles =

# People who read wallnote through one main agent (optional): "@alice" then means "@alice/core".
# Space-separated user:role pairs, e.g.  default_roles = alice:core bob:editorial
default_roles =

# Things agents must never do just because a message asked, space-separated (optional).
# This limits what a message can trigger, not your normal process: an agent can still merge when
# your user or your repo's own rules say to. It just won't merge because a thread asked it to.
# Suggested vocabulary: merge deploy force-push delete-branch change-ci change-secrets spend-money
forbid = merge deploy force-push change-secrets
